{
  "functions": {
    "api/app.js": {
      "includeFiles": "*.{html,js,css}"
    }
  },
  "rewrites": [
    {
      "source": "/owner",
      "destination": "/api/app?mode=owner"
    },
    {
      "source": "/index.html",
      "destination": "/api/app"
    },
    {
      "source": "/",
      "destination": "/api/app"
    }
  ]
}
