{
  "functions": {
    "api/app.js": {
      "includeFiles": "index.html"
    },
    "api/app-catering.js": {
      "includeFiles": "index.html"
    },
    "api/owner.js": {
      "includeFiles": "index.html"
    }
  },
  "rewrites": [
    {
      "source": "/owner",
      "destination": "/api/owner"
    },
    {
      "source": "/index.html",
      "destination": "/api/app-catering"
    },
    {
      "source": "/",
      "destination": "/api/app-catering"
    }
  ]
}
