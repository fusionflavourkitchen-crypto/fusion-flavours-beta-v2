{
  "functions": {
    "api/app.js": {
      "includeFiles": "{index.html,community-meals-labels.js,community-page-intro.js}"
    }
  },
  "rewrites": [
    {
      "source": "/owner",
      "destination": "/api/app?mode=owner"
    },
    {
      "source": "/index.html",
      "destination": "/api/app"
    },
    {
      "source": "/",
      "destination": "/api/app"
    }
  ]
}
